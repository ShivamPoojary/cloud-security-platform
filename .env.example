# ==============================================================================
# Cloud Security Monitoring & Threat Detection Platform - Environment Config
# ==============================================================================
# NOTE: Copy this file to .env for local development. Never commit .env to VCS.

# Environment Mode
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Security
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL 16)
POSTGRES_USER=secplatform_user
POSTGRES_PASSWORD=secplatform_dev_password
POSTGRES_DB=secplatform_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://secplatform_user:secplatform_dev_password@postgres:5432/secplatform_db
# For running tests/local scripts outside docker:
# DATABASE_URL=postgresql+asyncpg://secplatform_user:secplatform_dev_password@localhost:5432/secplatform_db
# SQLite fallback for standalone local tests:
# DATABASE_URL=sqlite+aiosqlite:///./test_secplatform.db

# Redis Cache & Ingestion Stream
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
# For running outside docker:
# REDIS_URL=redis://localhost:6379/0

# Seed Initial Accounts (Dev Only)
DEV_SEED_PASSWORD=DevSecOps2026!ChangeMe

# Synthetic Telemetry Settings
SYNTHETIC_EMISSION_RATE_SECONDS=2
DRY_RUN_MODE=True
